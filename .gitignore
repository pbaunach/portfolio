# Jekyll build artifacts
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Bundler
.bundle/
vendor/

# Environment variables
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.swp
*.swo
*~

# Orchard prototype (Vite + React)
orchard-prototype/node_modules/
orchard-prototype/dist/

# Sleeper's Tomb: only the web build is published. A Windows exe is over GitHub's
# 100 MiB per-file push limit, so keep any local one out of git.
sleepers-tomb/builds/**/*.exe

# Private working files. The repo is public, so keeping these out of the Jekyll build
# isn't enough; they stay local only.
.claude/
_handoff/
tools/
